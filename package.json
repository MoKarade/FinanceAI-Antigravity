    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "firebase": "^13.1.0",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.61.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
