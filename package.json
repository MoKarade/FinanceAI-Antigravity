    "test:rapide": "vitest run --project node",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --grep-invert @visual --max-failures=2",
    "knip": "knip",
    "portes": "node qualite/portes.mjs",
    "portes:maj": "node qualite/portes.mjs --maj",
    "check-contrast": "tsx scripts/check-contrast.ts",
    "fintable:dry": "tsx scripts/fintableDry.ts",
    "fintable:doctor": "tsx scripts/fintableDoctor.ts"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
